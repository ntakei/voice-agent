# .env.example を .env という名前でコピーして使う（.env は git に入らない）。
# 書いた項目だけ config.yaml の値より優先される。不要な行は消すか # を付けたままにする。

# モデルの API の URL（config.yaml の model.base_url の代わり）
# VA_BASE_URL=http://172.25.5.48:8000/v1

# モデル名（config.yaml の model.name の代わり）
# VA_MODEL=GLM-5.3-Flash-EXL3

# API キー（vLLM で --api-key を設定している場合だけ。画面やログには出さない）
# VA_API_KEY=
